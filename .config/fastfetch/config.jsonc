{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
      "source": "",
      "width": 25,
      "height": 13,
      "padding": {
          "top": 0,
          "right": 6
      }
  },
  "display": {
      "separator": " "
  },
  "modules": [
      "break",
      "break",
      {
          "type": "title",
          "keyWidth": 10,
          "format": "Hello, {#31}{user-name}{#}"
      },
      "break",
      {
          "type": "os",
          "key": " ",
          "keyColor": "31"
      },
      {
          "type": "kernel",
          "key": " ",
          "keyColor": "32"
      },
      {
          "type": "packages",
          "format": "{pacman} (pacman)",
          "key": " ",
          "keyColor": "33"
      },
      {
          "type": "shell",
          "key": " ",
          "keyColor": "34"
      },
      {
          "type": "terminal",
          "key": " ",
          "keyColor": "35"
      },
      {
          "type": "wm",
          "key": " ",
          "keyColor": "36"
      },
      {
          "type": "uptime",
          "key": " ",
          "keyColor": "37"
      },
      {
          "type": "media",
          "key": "󰝚 ",
          "keyColor": "31"
      },
      "break",
      {
          "type": "colors",
          "symbol": "block",
          "block": {
              "width": 3,
              "range": [9, 15]
          }
      },
      "break",
      "break"
  ]
}
