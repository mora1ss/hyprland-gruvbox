{
  "layer": "top",
  "spacing": 0,
  "height": 0,
  "margin-top": 8,
  "margin-right": 8,
  "margin-bottom": 0,
  "margin-left": 8,

  "modules-left": [
    "custom-arrow-left",
    "ext/workspaces"
  ],

  "modules-center": [
    "group/centerclock"
  ],

  "modules-right": [
    "tray",
    "cpu",
    "memory",
    "battery#bat1",
    "temperature",
    "battery#bat2",
    "pulseaudio",
    "clock#date"
  ],

  "custom-arrow-left": {
    "format": "->",
    "tooltip": false
  },

  "ext/workspaces": {
    "all-outputs": true,
    "active-only": false,
    "tooltip": false,
    "format": "{name}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
  },

  "tray": {
    "spacing": 10,
    "tooltip": false
  },
  "temperature": {
    "tooltip": false,
    "critical-threshold": 80,
    "format": "{temperatureC}°{icon}",
    "format-icons": [" ", "", " "]
  },

  "group/centerclock": {
    "orientation": "horizontal",
    "modules": [
      "custom/arch",
      "clock#time"
    ]
  },

  "custom/arch": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "Menu",
    "on-click": "$HOME/.local/bin/session-panel"
  },

  "clock#time": {
    "format": "{:%I:%M %p}",
    "tooltip": false
  },

  "clock#date": {
    "format": "{:%d/%m/%Y}",
    "tooltip": false
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 2,
    "states": {
      "critical": 90
    }
  },

  "memory": {
    "format": " {percentage}%",
    "interval": 2,
    "states": {
      "critical": 80
    }
  },

  "battery#bat1": {
    "bat": "BAT0",
    "adapter": "AC",
    "interval": 10,
    "full-at": 99,
    "states": {
      "full": 100,
      "good": 99,
      "empty": 5
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-empty": " {capacity}%",
    "format-full": " {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "battery#bat2": {
    "bat": "BAT1",
    "adapter": "AC",
    "interval": 10,
    "full-at": 99,
    "states": {
      "full": 100,
      "good": 99,
      "empty": 5
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-empty": " {capacity}%",
    "format-full": " {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "pulseaudio": {
    "scroll-step": 5,
    "max-volume": 150,
    "format": " {volume}%",
    "format-bluetooth": " {volume}%",
    "nospacing": 1,
    "on-click": "pavucontrol",
    "tooltip": false
  }
}
