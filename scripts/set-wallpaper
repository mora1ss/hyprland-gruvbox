#!/usr/bin/env bash
set -u

img="${1:-}"
img="${img//\\ / }"

pick_saved() {
  local f p
  for f in \
    "${HOME}/.cache/hypr-wallpaper" \
    "${HOME}/.cache/quickshell/hyprquickpaper/.current"
  do
    [[ -f "${f}" ]] || continue
    p="$(tr -d '\n' < "${f}")"
    p="${p//\\ / }"
    if [[ -f "${p}" ]]; then
      printf '%s\n' "${p}"
      return 0
    fi
  done
  printf '%s\n' "${HOME}/Imagens/Wallpapers/rockman.png"
}

if [[ -z "${img}" ]]; then
  img="$(pick_saved)"
fi

if [[ ! -f "${img}" ]]; then
  printf 'set-wallpaper: ficheiro inválido: %s\n' "${img}" >&2
  exit 1
fi

mkdir -p "${HOME}/.cache"
printf '%s\n' "${img}" > "${HOME}/.cache/hypr-wallpaper"

apply_awww() {
  awww query >/dev/null 2>&1 || { awww-daemon >/dev/null 2>&1 & sleep 0.6; }
  awww img "${img}"
}

apply_swww() {
  swww query >/dev/null 2>&1 || { swww-daemon --format xrgb >/dev/null 2>&1 & sleep 0.6; }
  swww img "${img}" --transition-type none || swww img "${img}"
}

if command -v awww >/dev/null; then
  apply_awww
elif command -v swww >/dev/null; then
  apply_swww
else
  printf 'set-wallpaper: instala awww (pacman -S awww)\n' >&2
  exit 1
fi
